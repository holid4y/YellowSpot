<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">
    <ImageView android:id="@+id/widget_artwork"
        android:layout_width="58dp" android:layout_height="58dp"
        android:scaleType="centerCrop" android:contentDescription="Album artwork"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:paddingStart="10dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/widget_song" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Spotify"
            android:textColor="#FFFFFFFF" android:textSize="14sp"
            android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Ready to play"
            android:textColor="#FFBBBBBB" android:textSize="12sp"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_prev" android:layout_width="42dp"
        android:layout_height="48dp" android:padding="10dp"
        android:src="@drawable/ic_previous" android:contentDescription="Previous track"/>
    <ImageView android:id="@+id/widget_toggle" android:layout_width="42dp"
        android:layout_height="48dp" android:padding="8dp"
        android:src="@drawable/ic_play" android:contentDescription="Play or pause"/>
    <ImageView android:id="@+id/widget_next" android:layout_width="42dp"
        android:layout_height="48dp" android:padding="10dp"
        android:src="@drawable/ic_next" android:contentDescription="Next track"/>
</LinearLayout>
